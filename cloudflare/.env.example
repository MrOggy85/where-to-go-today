# Copy to cloudflare/.env (untracked, 0600). Read by ./wr to render wrangler.jsonc.
CF_ACCOUNT_ID=
# The public hostname and its zone. One level below the zone, so the zone's wildcard
# certificate covers it and no certificate names it. Needs a proxied AAAA 100:: record.
HOSTNAME=
ZONE_NAME=
# The D1 database made in the dashboard (README, First deployment).
D1_NAME=where-to-go-today
D1_ID=
# The R2 bucket made in the dashboard.
R2_BUCKET=where-to-go-today-photos
# The API token wrangler uses, not set here: see TOKEN_FILE.
# File holding CLOUDFLARE_API_TOKEN=..., 0600, outside the repo.
TOKEN_FILE=$HOME/.config/where-to-go-today/cloudflare.env
