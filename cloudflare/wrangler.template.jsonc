// Template for wrangler.jsonc, which ./wr renders from this file and .env (see
// .env.example) so the account, database ids and hostname stay out of this public repo.
// Edit this file, never the output. __NAME__ placeholders are replaced verbatim.
{
  "$schema": "/opt/cloudflare/node_modules/wrangler/config-schema.json",
  "name": "where-to-go-today",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "account_id": "__CF_ACCOUNT_ID__",

  // The one way in: a Route on the zone, not a Custom Domain. A Custom Domain gets its
  // own certificate, which publishes the hostname in Certificate Transparency; a Route
  // on a proxied record is served under the zone's wildcard certificate and names
  // nothing: privacy by not publishing. The proxied record (AAAA 100::) is made once by hand; see README.
  // Also the account's workers.dev address (chosen 2026-11-17: the main entry until the
  // DNS record exists; *.workers.dev is itself a wildcard certificate, so it names
  // nothing in CT either). No preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "__HOSTNAME__/*", "zone_name": "__ZONE__" }],

  // The client bundle (make build -> api/client). run_worker_first: the Worker sees every
  // request, so the country filter and throttle run before any file is served, and the
  // Worker serves index.html for page paths itself (not_found_handling stays "none").
  "assets": {
    "directory": "../api/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__D1_NAME__",
      "database_id": "__D1_ID__",
      "migrations_dir": "migrations"
    }
  ],

  // Every request, per client address: 600 a minute, as on the Deno server (approximate,
  // per Cloudflare location). The login throttle is strict and lives in D1 instead.
  "ratelimits": [
    { "name": "REQUESTS", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }
  ],

  // GEO_ALLOW_COUNTRIES: empty admits every country (chosen 2026-11-16, so it works
  // abroad without a step); `JP` or `JP,SE` turns the filter on, before anything else.
  // PBKDF2_ITERATIONS: for new password hashes, at most 100000 on Workers. Lower it only
  // if logins exceed the Free plan's CPU limit (Observability -> CPU time).
  "vars": { "GEO_ALLOW_COUNTRIES": "", "PBKDF2_ITERATIONS": "100000" },
  // OPS_TOKEN is a secret: ./wr secret put OPS_TOKEN

  // 03:17 JST: expired sessions, stale login counters, log lines past 90 days.
  "triggers": { "crons": ["17 18 * * *"] },

  "observability": { "enabled": true }
}
