# Copy to deploy/.env and fill in. deploy/.env is gitignored and must stay that way:
# this is a public repo. See CLAUDE.md "Deployment".

# The node name inside the tailnet. Becomes the first label of the public hostname.
TS_HOSTNAME=where-to-go-today

# Your tailnet's DNS zone, e.g. tailXXXXXX.ts.net (Admin console -> DNS).
# Kept out of git: it is effectively a shared secret, since knowing it is the first
# step in probing every other service on the tailnet.
TS_TAILNET=tailXXXXXX.ts.net

# Tailscale auth key. Generate at https://login.tailscale.com/admin/settings/keys with:
#   Reusable:  ON   (sidecar.sh recreates the container on every run, which would
#                    burn a single-use key)
#   Ephemeral: OFF  (an ephemeral node is deleted when it goes offline, taking the
#                    public hostname with it)
#
# Only read on first authentication. Afterwards the credential lives in
# deploy/tailscale_state/ and restarts do not touch it.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
